{
  "interaction": { "inspectOnlyWhenOpen": true, "clearPreviousResult": true },
  "marker": { "enabled": true, "color": [0, 122, 194, 255], "size": 14, "outlineColor": [255,255,255,255], "outlineWidth": 2 },
  "highlight": { "enabled": true },
  "execution": { "cacheTtlMs": 60000, "continueOnError": true },
  "workflow": [
    {
      "id": "parcel",
      "type": "spatialQuery",
      "source": { "matchBy": "title", "value": "Parcels" },
      "geometry": "{{input.mapPoint}}",
      "relationship": "intersects",
      "fields": ["OBJECTID", "PARCEL_ID", "OWNER_ID", "OWNER_NAME"],
      "returnGeometry": true,
      "resultMode": "first",
      "output": "parcel",
      "onError": "stop"
    },
    {
      "id": "relatedData",
      "type": "parallel",
      "steps": [
        {
          "id": "zoning",
          "type": "spatialQuery",
          "source": { "matchBy": "title", "value": "Zoning" },
          "geometry": "{{parcel.geometry}}",
          "relationship": "intersects",
          "fields": ["ZONE_CODE", "ZONE_NAME"],
          "resultMode": "first",
          "output": "zoning"
        },
        {
          "id": "inspections",
          "type": "attributeQuery",
          "source": { "matchBy": "title", "value": "Inspections" },
          "where": "PARCEL_ID = '{{parcel.PARCEL_ID}}'",
          "fields": ["OBJECTID", "STATUS", "SCORE", "INSPECTION_DATE"],
          "orderBy": ["SCORE DESC", "INSPECTION_DATE DESC"],
          "maxRecords": 20,
          "output": "inspections"
        }
      ]
    },
    {
      "id": "bestInspection",
      "type": "selectRecord",
      "input": "inspections",
      "mode": "best",
      "rules": [
        { "field": "SCORE", "direction": "descending" },
        { "field": "INSPECTION_DATE", "direction": "descending" }
      ],
      "output": "bestInspection"
    },
    { "id": "inspectionCount", "type": "statistics", "input": "inspections", "operation": "count", "output": "inspectionCount" },
    { "id": "risk", "type": "expression", "expression": "bestInspection ? FN.IF(bestInspection.SCORE < 50, 'HIGH', 'LOW') : 'UNKNOWN'", "output": "riskLevel" }
  ],
  "display": {
    "mode": "template",
    "input": "parcel",
    "emptyValue": "—",
    "highlight": true,
    "template": "<section class='udi-card'><h2>Property summary</h2><table class='udi-table'><tr><th>Parcel</th><td>{{parcel.PARCEL_ID}}</td></tr><tr><th>Owner</th><td>{{parcel.OWNER_NAME}}</td></tr><tr><th>Zoning</th><td>{{zoning.ZONE_NAME}}</td></tr><tr><th>Best inspection</th><td>{{bestInspection.STATUS}}</td></tr><tr><th>Score</th><td>{{bestInspection.SCORE}}</td></tr><tr><th>Inspection count</th><td>{{inspectionCount}}</td></tr><tr><th>Risk</th><td>{{riskLevel}}</td></tr></table></section>"
  }
}
