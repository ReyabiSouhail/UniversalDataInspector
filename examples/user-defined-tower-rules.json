{
  "interaction": {
    "inspectOnlyWhenOpen": true,
    "clearPreviousResult": true,
    "tolerancePixels": 10
  },
  "marker": {
    "enabled": true,
    "color": [0, 122, 194, 255],
    "size": 16,
    "outlineColor": [255, 255, 255, 255],
    "outlineWidth": 2
  },
  "execution": { "cacheTtlMs": 60000, "maxConcurrentQueries": 8 },
  "sources": [
    {
      "key": "tower_a",
      "title": "Tower A",
      "source": { "matchBy": "title", "value": "Tower A" },
      "where": "STATUS = 'ACTIVE'",
      "relationship": "intersects",
      "maxRecords": 100,
      "returnGeometry": true,
      "fieldMap": {
        "speed": "SPEED",
        "status": "STATUS",
        "technology": "TECHNOLOGY",
        "updated": "UPDATED_DATE"
      },
      "displayFields": ["speed", "status", "technology"]
    },
    {
      "key": "tower_b",
      "title": "Tower B",
      "source": { "matchBy": "title", "value": "Tower B" },
      "where": "1=1",
      "relationship": "intersects",
      "maxRecords": 100,
      "returnGeometry": true,
      "fieldMap": {
        "speed": "DOWNLOAD_RATE",
        "status": "STATE",
        "technology": "NETWORK_TYPE",
        "updated": "LAST_UPDATE"
      },
      "displayFields": ["speed", "status", "technology"]
    }
  ],
  "rules": [
    {
      "id": "best_active_speed",
      "name": "Best active speed",
      "description": "The administrator defines this rule: active candidates first, highest speed, newest update as a tie breaker.",
      "enabled": true,
      "sourceKeys": ["tower_a", "tower_b"],
      "conditionLogic": "and",
      "conditions": [
        { "field": "status", "operator": "equals", "value": "ACTIVE" }
      ],
      "sort": [
        { "field": "speed", "valueType": "number", "direction": "descending", "priority": [] },
        { "field": "updated", "valueType": "date", "direction": "descending", "priority": [] }
      ],
      "take": 1,
      "displayFields": ["speed", "status", "technology", "updated"],
      "templateMode": "default",
      "customTemplate": "",
      "emptyText": "No active tower was found."
    },
    {
      "id": "preferred_technology",
      "name": "Preferred technology",
      "enabled": true,
      "sourceKeys": [],
      "conditionLogic": "and",
      "conditions": [],
      "sort": [
        {
          "field": "technology",
          "valueType": "priorityText",
          "direction": "descending",
          "priority": ["5G", "4G", "3G", "2G"]
        },
        { "field": "speed", "valueType": "number", "direction": "descending", "priority": [] }
      ],
      "take": 3,
      "displayFields": ["technology", "speed", "status"],
      "templateMode": "default",
      "customTemplate": ""
    }
  ],
  "display": {
    "emptyValue": "—",
    "noResultText": "No matching feature was found at this location.",
    "highlight": true,
    "maxFields": 12
  }
}
